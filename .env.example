# ─── Form e-posta (Resend) ─────────────────────────────────────────
# GitHub / Vercel hesabı: housedoctorweb@gmail.com
# Form mesajlarının gideceği adres (ziyaretçiye görünmez, sadece teslimat):
CONTACT_TO_EMAIL=alpsule@hotmail.com

# Resend API key — https://resend.com → API Keys
